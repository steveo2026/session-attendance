/* Session Attendance v2 Google Sheets connector
Setup: Google Sheet -> Extensions -> Apps Script -> paste this -> Deploy as Web app, execute as Me, access Anyone. Copy /exec URL into app Settings.
Each sync replaces the Attendance Records and Player Summary tabs with the phone's current data. */
function doPost(e){try{var p=JSON.parse(e.postData.contents||'{}'),ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ss.getSheetByName('Attendance Records')||ss.insertSheet('Attendance Records'),su=ss.getSheetByName('Player Summary')||ss.insertSheet('Player Summary'),players=p.players||[],sessions=p.sessions||[],rows=[['Player','Session Date','Attendance','Session Cost (£)','Amount Owed (£)','Session Note','Player Note']];sessions.sort(function(a,b){return String(a.date).localeCompare(String(b.date))});sessions.forEach(function(s){players.forEach(function(pl){var a=(s.attendance||{})[pl.id]||{status:'no',note:''},yes=a.status==='yes';rows.push([pl.name,s.date,yes?'Attended':'Not attended',Number(s.cost||0),yes?Number(s.cost||0):0,s.note||'',a.note||''])})});sh.clearContents();sh.getRange(1,1,rows.length,rows[0].length).setValues(rows);sh.setFrozenRows(1);var totals={};players.forEach(function(pl){totals[pl.id]={n:0,owed:0}});sessions.forEach(function(s){players.forEach(function(pl){var a=(s.attendance||{})[pl.id];if(a&&a.status==='yes'){totals[pl.id].n++;totals[pl.id].owed+=Number(s.cost||0)}})});var sr=[['Player','Sessions Attended','Total Owed (£)']];players.forEach(function(pl){sr.push([pl.name,totals[pl.id].n,totals[pl.id].owed])});su.clearContents();su.getRange(1,1,sr.length,sr[0].length).setValues(sr);su.setFrozenRows(1);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON)}}
